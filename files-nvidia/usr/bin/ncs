#!/usr/bin/bash
[[ $UID -eq 0 ]] || exec sudo $0 "$@"
set -e

nvidia-ctk cdi generate --output=/etc/cdi/nvidia.yaml

add() {
    if rg -q $1 /etc/cdi/nvidia.yaml
    then
        return
    fi

    IFS= read -rd '' entry <<-EOF || true
        - hostPath: $1
          containerPath: $1
          options:
            - ro
            - nosuid
            - nodev
            - rbind
            - rprivate
	EOF
    entry=${entry%$'\n'}

    sed -i "/mounts:/a\\${entry//$'\n'/\\n}" /etc/cdi/nvidia.yaml
}

for path in $(rpm -ql nvidia-driver-libs.i686)
do
    if [[ -d $path ]]
    then
        continue
    fi

    add $path
done
